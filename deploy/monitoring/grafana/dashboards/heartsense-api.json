    {
      "id": 14,
      "title": "Requests / s per pod",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "heartsense-prom"
      },
      "gridPos": {
        "x": 16,
        "y": 20,
        "w": 8,
        "h": 7
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "heartsense-prom"
          },
          "expr": "sum by (pod) (rate(heartsense_http_requests_total{path=~\"/predict.*\"}[2m]))",
          "legendFormat": "{{pod}}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
