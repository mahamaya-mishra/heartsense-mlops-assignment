{
  "uid": "heartsense-api",
  "title": "HeartSense API",
  "tags": [
    "heartsense",
    "mlops"
  ],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "editable": false,
  "refresh": "10s",
  "time": {
    "from": "now-30m",
    "to": "now"
  },
  "panels": [
    {
      "id": 1,
      "title": "Replicas scraped",
      "type": "stat",
      "datasource": {
        "type": "prometheus",
        "uid": "heartsense-prom"
      },
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 4,
        "h": 4
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "heartsense-prom"
          },
          "expr": "count(up{job=\"heartsense-api\"} == 1)",
          "legendFormat": "up",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "orange",
                "value": 1
              },
              {
                "color": "green",
                "value": 2
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "area",
        "textMode": "value"
      }
    },
    {
      "id": 2,
      "title": "Model ready (all replicas)",
      "type": "stat",
      "datasource": {
        "type": "prometheus",
        "uid": "heartsense-prom"
      },
      "gridPos": {
        "x": 4,
        "y": 0,
        "w": 4,
        "h": 4
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "heartsense-prom"
          },
          "expr": "min(heartsense_model_ready)",
          "legendFormat": "ready",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "green",
                "value": 1
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "area",
        "textMode": "value"
      }
    },
    {
      "id": 3,
      "title": "Requests / s (5m)",
      "type": "stat",
      "datasource": {
        "type": "prometheus",
        "uid": "heartsense-prom"
      },
      "gridPos": {
        "x": 8,
        "y": 0,
        "w": 4,
        "h": 4
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "heartsense-prom"
          },
          "expr": "sum(rate(heartsense_http_requests_total{path=~\"/predict.*\"}[5m]))",
          "legendFormat": "rps",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "reqps"
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "area",
        "textMode": "value"
      }
    },
    {
      "id": 4,
      "title": "p95 latency /predict",
      "type": "stat",
      "datasource": {
        "type": "prometheus",
        "uid": "heartsense-prom"
      },
      "gridPos": {
        "x": 12,
        "y": 0,
        "w": 4,
        "h": 4
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "heartsense-prom"
          },
          "expr": "histogram_quantile(0.95, sum(rate(heartsense_http_request_duration_seconds_bucket{path=\"/predict\"}[5m])) by (le))",
          "legendFormat": "p95",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "orange",
                "value": 0.1
              },
              {
                "color": "red",
                "value": 0.25
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "area",
        "textMode": "value"
      }
    },
    {
      "id": 5,
      "title": "5xx error ratio (5m)",
      "type": "stat",
      "datasource": {
        "type": "prometheus",
        "uid": "heartsense-prom"
      },
      "gridPos": {
        "x": 16,
        "y": 0,
        "w": 4,
        "h": 4
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "heartsense-prom"
          },
          "expr": "sum(rate(heartsense_http_requests_total{status=~\"5..\"}[5m])) / sum(rate(heartsense_http_requests_total[5m]))",
          "legendFormat": "5xx",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "orange",
                "value": 0.01
              },
              {
                "color": "red",
                "value": 0.05
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "area",
        "textMode": "value"
      }
    },
    {
      "id": 6,
      "title": "Predictions served (total)",
      "type": "stat",
      "datasource": {
        "type": "prometheus",
        "uid": "heartsense-prom"
      },
      "gridPos": {
        "x": 20,
        "y": 0,
        "w": 4,
        "h": 4
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "heartsense-prom"
          },
          "expr": "sum(heartsense_predictions_total)",
          "legendFormat": "total",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "area",
        "textMode": "value"
      }
    },
    {
      "id": 7,
      "title": "Request rate by path and status",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "heartsense-prom"
      },
      "gridPos": {
        "x": 0,
        "y": 4,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "heartsense-prom"
          },
          "expr": "sum by (path, status) (rate(heartsense_http_requests_total[2m]))",
          "legendFormat": "{{path}} {{status}}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "reqps"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      }
    },
    {
      "id": 8,
      "title": "Latency quantiles /predict",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "heartsense-prom"
      },
      "gridPos": {
        "x": 12,
        "y": 4,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "heartsense-prom"
          },
          "expr": "histogram_quantile(0.50, sum(rate(heartsense_http_request_duration_seconds_bucket{path=\"/predict\"}[2m])) by (le))",
          "legendFormat": "p50",
          "refId": "A"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "heartsense-prom"
          },
          "expr": "histogram_quantile(0.95, sum(rate(heartsense_http_request_duration_seconds_bucket{path=\"/predict\"}[2m])) by (le))",
          "legendFormat": "p95",
          "refId": "B"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "heartsense-prom"
          },
          "expr": "histogram_quantile(0.99, sum(rate(heartsense_http_request_duration_seconds_bucket{path=\"/predict\"}[2m])) by (le))",
          "legendFormat": "p99",
          "refId": "C"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      }
    },
    {
      "id": 9,
      "title": "Predictions / s by risk tier",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "heartsense-prom"
      },
      "gridPos": {
        "x": 0,
        "y": 12,
        "w": 8,
        "h": 8
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "heartsense-prom"
          },
          "expr": "sum by (risk_tier) (rate(heartsense_predictions_total[2m]))",
          "legendFormat": "{{risk_tier}}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "stacking": {
              "mode": "normal"
            },
            "fillOpacity": 40
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      }
    },
    {
      "id": 10,
      "title": "Share of positive predictions vs training prevalence (0.46)",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "heartsense-prom"
      },
      "gridPos": {
        "x": 8,
        "y": 12,
        "w": 8,
        "h": 8
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "heartsense-prom"
          },
          "expr": "sum(rate(heartsense_predictions_total{label=\"disease\"}[10m])) / sum(rate(heartsense_predictions_total[10m]))",
          "legendFormat": "positive share (10m)",
          "refId": "A"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "heartsense-prom"
          },
          "expr": "vector(0.4587)",
          "legendFormat": "training prevalence",
          "refId": "B"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "min": 0,
          "max": 1
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "training prevalence"
            },
            "properties": [
              {
                "id": "custom.lineStyle",
                "value": {
                  "dash": [
                    10,
                    10
                  ],
                  "fill": "dash"
                }
              },
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "red"
                }
              }
            ]
          }
        ]
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      }
    },
    {
      "id": 11,
      "title": "Risk score distribution (heatmap)",
      "type": "heatmap",
      "datasource": {
        "type": "prometheus",
        "uid": "heartsense-prom"
      },
      "gridPos": {
        "x": 16,
        "y": 12,
        "w": 8,
        "h": 8
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "heartsense-prom"
          },
          "expr": "sum(increase(heartsense_risk_score_bucket[2m])) by (le)",
          "legendFormat": "{{le}}",
          "format": "heatmap",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      },
      "options": {
        "calculate": false,
        "yAxis": {
          "unit": "short"
        },
        "color": {
          "scheme": "Oranges",
          "mode": "scheme"
        },
        "cellGap": 1
      }
    },
    {
      "id": 12,
      "title": "Validation rejections (422) / s",
      "type": "timeseries",
      "datasource": {
